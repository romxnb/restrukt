+<?php
+
+namespace App\Tests\Api;
+
+use App\Entity\Employee;
+use App\Entity\Team;
+
+final class LeaveRequestTest extends ApiTestCase
+{
+    private Team $team;
+    private Employee $olena;
+    private Employee $taras;
+
+    protected function setUp(): void
+    {
+        parent::setUp();
+        self::mockTime('2026-03-02 09:00'); // Monday
+        $this->team = $this->createTeam();
+        $this->olena = $this->createEmployee('Олена Коваль', $this->team);
+        $this->taras = $this->createEmployee('Тарас Мельник', $this->team, annualLeaveDays: 5);
+        $this->team->assignManager($this->olena);
+        $this->entityManager->flush();
+    }
+
+    public function testRequestLastsWorkingDaysWithoutHolidays(): void
+    {
+        $this->createHoliday('2026-03-11', 'Свято');
+
+        $request = $this->requestAs($this->taras, 'POST', '/api/leave-requests', ['startDate' => '2026-03-09', 'endDate' => '2026-03-15']);
+
+        self::assertResponseStatusCodeSame(201);
+        self::assertSame(4, $request['workingDays']);
+        self::assertSame('pending', $request['status']);
+        self::assertEmailCount(1);
+    }
+
+    /**
+     * @return iterable<string, array{array<string, string>, string}>
+     */
+    public static function refusedSubmissions(): iterable
+    {
+        yield 'date in another format' => [['startDate' => '09.03.2026', 'endDate' => '2026-03-10'], 'Вкажіть дати у форматі РРРР-ММ-ДД.'];
+        yield 'start after end' => [['startDate' => '2026-03-10', 'endDate' => '2026-03-09'], 'Дата початку пізніша за дату завершення.'];
+        yield 'two years' => [['startDate' => '2026-12-28', 'endDate' => '2027-01-04'], 'Заява не може охоплювати два роки.'];
+        yield 'weekend only' => [['startDate' => '2026-03-07', 'endDate' => '2026-03-08'], 'У вибраному періоді немає робочих днів.'];
+        yield 'long comment' => [['startDate' => '2026-03-09', 'endDate' => '2026-03-10', 'comment' => str_repeat('я', 501)], 'Коментар не довший за 500 символів.'];
+    }
+
+    /**
+     * @param array<string, string> $submission
+     */
+    #[\PHPUnit\Framework\Attributes\DataProvider('refusedSubmissions')]
+    public function testBrokenRuleIsNamed(array $submission, string $message): void
+    {
+        $error = $this->requestAs($this->taras, 'POST', '/api/leave-requests', $submission);
+
+        self::assertResponseStatusCodeSame(422);
+        self::assertSame($message, $error['error']);
+    }
+
+    public function testCancelledRequestFreesItsDays(): void
+    {
+        $request = $this->requestAs($this->taras, 'POST', '/api/leave-requests', ['startDate' => '2026-03-09', 'endDate' => '2026-03-10']);
+
+        $cancelled = $this->requestAs($this->taras, 'POST', "/api/leave-requests/{$request['id']}/cancel");
+
+        self::assertSame('cancelled', $cancelled['status']);
+        self::assertSame(5, $this->requestAs($this->taras, 'GET', '/api/leave-requests')['balance']['remaining']);
+    }
+
+    public function testColleaguesRequestIsNotFound(): void
+    {
+        $request = $this->requestAs($this->olena, 'POST', '/api/leave-requests', ['startDate' => '2026-03-09', 'endDate' => '2026-03-10']);
+
+        $error = $this->requestAs($this->taras, 'POST', "/api/leave-requests/{$request['id']}/cancel");
+
+        self::assertResponseStatusCodeSame(404);
+        self::assertSame('Заяву не знайдено.', $error['error']);
+    }
+
+    public function testRejectionNeedsReason(): void
+    {
+        $request = $this->requestAs($this->taras, 'POST', '/api/leave-requests', ['startDate' => '2026-03-09', 'endDate' => '2026-03-10']);
+
+        $error = $this->requestAs($this->olena, 'POST', "/api/team/leave-requests/{$request['id']}/reject", ['reason' => ' ']);
+
+        self::assertSame('Вкажіть причину відмови.', $error['error']);
+    }
+
+    public function testManagerSeesPendingRequestsOfTeam(): void
+    {
+        $this->requestAs($this->taras, 'POST', '/api/leave-requests', ['startDate' => '2026-03-09', 'endDate' => '2026-03-10']);
+
+        $pending = $this->requestAs($this->olena, 'GET', '/api/team/leave-requests');
+
+        self::assertSame(['Тарас Мельник'], array_column(array_column($pending, 'employee'), 'name'));
+    }
+
+    public function testRequestBeyondRemainingDaysIsRefused(): void
+    {
+        $this->requestAs($this->taras, 'POST', '/api/leave-requests', ['startDate' => '2026-03-02', 'endDate' => '2026-03-04']);
+
+        $error = $this->requestAs($this->taras, 'POST', '/api/leave-requests', ['startDate' => '2026-03-16', 'endDate' => '2026-03-18']);
+
+        self::assertResponseStatusCodeSame(422);
+        self::assertSame('Недостатньо днів відпустки: залишилось 2.', $error['error']);
+    }
+
+    public function testOverlappingRequestIsRefused(): void
+    {
+        $this->requestAs($this->taras, 'POST', '/api/leave-requests', ['startDate' => '2026-03-09', 'endDate' => '2026-03-10']);
+
+        $error = $this->requestAs($this->taras, 'POST', '/api/leave-requests', ['startDate' => '2026-03-10', 'endDate' => '2026-03-11']);
+
+        self::assertSame('Період перетинається з іншою заявою.', $error['error']);
+    }
+
+    public function testRequestInThePastIsRefused(): void
+    {
+        $error = $this->requestAs($this->taras, 'POST', '/api/leave-requests', ['startDate' => '2026-02-27', 'endDate' => '2026-03-02']);
+
+        self::assertSame('Не можна подати заяву на минулу дату.', $error['error']);
+    }
+
+    public function testManagersOwnRequestIsApproved(): void
+    {
+        $request = $this->requestAs($this->olena, 'POST', '/api/leave-requests', ['startDate' => '2026-03-09', 'endDate' => '2026-03-10']);
+
+        self::assertSame('approved', $request['status']);
+        self::assertEmailCount(0);
+    }
+
+    public function testBalanceCountsApprovedAndPendingDays(): void
+    {
+        $approved = $this->requestAs($this->taras, 'POST', '/api/leave-requests', ['startDate' => '2026-03-09', 'endDate' => '2026-03-10']);
+        $this->requestAs($this->olena, 'POST', "/api/team/leave-requests/{$approved['id']}/approve");
+        $this->requestAs($this->taras, 'POST', '/api/leave-requests', ['startDate' => '2026-03-16', 'endDate' => '2026-03-16']);
+
+        $mine = $this->requestAs($this->taras, 'GET', '/api/leave-requests');
+
+        self::assertSame(['allowance' => 5, 'approved' => 2, 'pending' => 1, 'remaining' => 2], $mine['balance']);
+    }
+
+    public function testStartedRequestCannotBeCancelled(): void
+    {
+        $request = $this->requestAs($this->taras, 'POST', '/api/leave-requests', ['startDate' => '2026-03-02', 'endDate' => '2026-03-03']);
+
+        $error = $this->requestAs($this->taras, 'POST', "/api/leave-requests/{$request['id']}/cancel");
+
+        self::assertResponseStatusCodeSame(422);
+        self::assertSame('Скасувати можна лише заяву, що ще не почалася.', $error['error']);
+    }
+
+    public function testManagerRejectsWithReasonAndEmployeeIsNotified(): void
+    {
+        $request = $this->requestAs($this->taras, 'POST', '/api/leave-requests', ['startDate' => '2026-03-09', 'endDate' => '2026-03-10']);
+
+        $decision = $this->requestAs($this->olena, 'POST', "/api/team/leave-requests/{$request['id']}/reject", ['reason' => 'Реліз']);
+
+        self::assertSame('rejected', $decision['status']);
+        $email = self::getMailerMessage();
+        self::assertNotNull($email);
+        self::assertEmailTextBodyContains($email, 'Реліз');
+    }
+
+    public function testDecidedRequestCannotBeDecidedAgain(): void
+    {
+        $request = $this->requestAs($this->taras, 'POST', '/api/leave-requests', ['startDate' => '2026-03-09', 'endDate' => '2026-03-10']);
+        $this->requestAs($this->olena, 'POST', "/api/team/leave-requests/{$request['id']}/approve");
+
+        $error = $this->requestAs($this->olena, 'POST', "/api/team/leave-requests/{$request['id']}/approve");
+
+        self::assertSame('Заяву вже розглянуто.', $error['error']);
+    }
+
+    public function testOnlyTeamManagerDecides(): void
+    {
+        $request = $this->requestAs($this->taras, 'POST', '/api/leave-requests', ['startDate' => '2026-03-09', 'endDate' => '2026-03-10']);
+
+        $error = $this->requestAs($this->taras, 'POST', "/api/team/leave-requests/{$request['id']}/approve");
+
+        self::assertResponseStatusCodeSame(403);
+        self::assertSame('Доступно лише керівнику команди.', $error['error']);
+    }
+}
