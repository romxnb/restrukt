+import { api } from './client'
+
+export type LeaveStatus = 'pending' | 'approved' | 'rejected' | 'cancelled'
+
+export interface LeaveRequest {
+  id: number
+  startDate: string
+  endDate: string
+  workingDays: number
+  status: LeaveStatus
+  comment: string | null
+  rejectionReason: string | null
+  cancellable: boolean
+}
+
+export interface LeaveBalance {
+  allowance: number
+  approved: number
+  pending: number
+  remaining: number
+}
+
+export interface MyLeave {
+  year: number
+  balance: LeaveBalance
+  requests: LeaveRequest[]
+}
+
+export interface TeamLeaveRequest {
+  id: number
+  employee: { id: number; name: string }
+  startDate: string
+  endDate: string
+  workingDays: number
+  comment: string | null
+}
+
+export interface LeaveSubmission {
+  startDate: string
+  endDate: string
+  comment: string | null
+}
+
+export const fetchMyLeave = () => api.get<MyLeave>('/api/leave-requests')
+export const submitLeaveRequest = (submission: LeaveSubmission) =>
+  api.post<LeaveRequest>('/api/leave-requests', submission)
+export const cancelLeaveRequest = (id: number) => api.post<LeaveRequest>(`/api/leave-requests/${id}/cancel`)
+
+export const fetchTeamLeaveRequests = () => api.get<TeamLeaveRequest[]>('/api/team/leave-requests')
+export const approveLeaveRequest = (id: number) => api.post(`/api/team/leave-requests/${id}/approve`)
+export const rejectLeaveRequest = (id: number, reason: string) =>
+  api.post(`/api/team/leave-requests/${id}/reject`, { reason })
