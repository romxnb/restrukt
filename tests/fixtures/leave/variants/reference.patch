+<script setup lang="ts">
+import { onMounted, ref } from 'vue'
+import { cancelLeaveRequest, fetchMyLeave, type LeaveRequest, type LeaveStatus, type MyLeave } from '@/api/leave'
+import LeaveRequestForm from '@/components/LeaveRequestForm.vue'
+import { formatPeriod } from '@/format'
+
+const statusLabels: Record<LeaveStatus, string> = {
+  pending: 'На розгляді',
+  approved: 'Погоджено',
+  rejected: 'Відхилено',
+  cancelled: 'Скасовано',
+}
+
+const leave = ref<MyLeave | null>(null)
+const error = ref('')
+
+async function load() {
+  try {
+    leave.value = await fetchMyLeave()
+  } catch (e) {
+    error.value = (e as Error).message
+  }
+}
+
+async function cancel(request: LeaveRequest) {
+  error.value = ''
+  try {
+    await cancelLeaveRequest(request.id)
+    await load()
+  } catch (e) {
+    error.value = (e as Error).message
+  }
+}
+
+onMounted(load)
+</script>
+
+<template>
+  <h1>Мої відпустки</h1>
+  <p v-if="error" class="error" role="alert">{{ error }}</p>
+
+  <template v-if="leave">
+    <ul class="balance">
+      <li>Річна норма: {{ leave.balance.allowance }}</li>
+      <li>Погоджено: {{ leave.balance.approved }}</li>
+      <li>На розгляді: {{ leave.balance.pending }}</li>
+      <li>Залишок: {{ leave.balance.remaining }}</li>
+    </ul>
+
+    <LeaveRequestForm @submitted="load" />
+
+    <h2>Заяви {{ leave.year }} року</h2>
+    <p v-if="leave.requests.length === 0">Заяв цього року немає.</p>
+    <table v-else>
+      <tbody>
+        <tr v-for="request in leave.requests" :key="request.id">
+          <td>{{ formatPeriod(request.startDate, request.endDate) }}</td>
+          <td>Робочих днів: {{ request.workingDays }}</td>
+          <td>
+            {{ statusLabels[request.status] }}
+            <template v-if="request.rejectionReason">: {{ request.rejectionReason }}</template>
+          </td>
+          <td>
+            <button v-if="request.cancellable" type="button" @click="cancel(request)">Скасувати</button>
+          </td>
+        </tr>
+      </tbody>
+    </table>
+  </template>
+</template>
+
+<style scoped>
+.balance {
+  display: flex;
+  gap: 1.5rem;
+  list-style: none;
+  padding: 0;
+}
+</style>
