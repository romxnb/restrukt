+import { flushPromises, mount } from '@vue/test-utils'
+import { beforeEach, describe, expect, it, vi } from 'vitest'
+import { ApiError } from '@/api/client'
+import * as leave from '@/api/leave'
+import LeavePage from './LeavePage.vue'
+
+const pendingRequest: leave.LeaveRequest = {
+  id: 7,
+  startDate: '2026-10-05',
+  endDate: '2026-10-09',
+  workingDays: 5,
+  status: 'pending',
+  comment: null,
+  rejectionReason: null,
+  cancellable: true,
+}
+
+function myLeave(requests: leave.LeaveRequest[]): leave.MyLeave {
+  const pending = requests.filter((request) => request.status === 'pending').length * 5
+  return { year: 2026, balance: { allowance: 24, approved: 0, pending, remaining: 24 - pending }, requests }
+}
+
+describe('LeavePage', () => {
+  beforeEach(() => {
+    vi.restoreAllMocks()
+  })
+
+  it('shows the balance and the requests of the year', async () => {
+    vi.spyOn(leave, 'fetchMyLeave').mockResolvedValue(myLeave([pendingRequest]))
+    const page = mount(LeavePage)
+    await flushPromises()
+
+    expect(page.text()).toContain('Залишок: 19')
+    expect(page.text()).toContain('05.10.2026 – 09.10.2026')
+    expect(page.text()).toContain('На розгляді')
+  })
+
+  it('reloads the balance after cancelling a request', async () => {
+    const fetch = vi.spyOn(leave, 'fetchMyLeave').mockResolvedValueOnce(myLeave([pendingRequest]))
+    fetch.mockResolvedValueOnce(myLeave([{ ...pendingRequest, status: 'cancelled', cancellable: false }]))
+    vi.spyOn(leave, 'cancelLeaveRequest').mockResolvedValue({ ...pendingRequest, status: 'cancelled' })
+    const page = mount(LeavePage)
+    await flushPromises()
+
+    await page.get('button[type="button"]').trigger('click')
+    await flushPromises()
+
+    expect(leave.cancelLeaveRequest).toHaveBeenCalledWith(7)
+    expect(page.text()).toContain('Скасовано')
+    expect(page.text()).toContain('Залишок: 24')
+  })
+
+  it('shows why a request was refused', async () => {
+    vi.spyOn(leave, 'fetchMyLeave').mockResolvedValue(myLeave([]))
+    vi.spyOn(leave, 'submitLeaveRequest').mockRejectedValue(new ApiError('Період перетинається з іншою заявою.', 422))
+    const page = mount(LeavePage)
+    await flushPromises()
+
+    await page.get('form').trigger('submit')
+    await flushPromises()
+
+    expect(page.get('[role="alert"]').text()).toBe('Період перетинається з іншою заявою.')
+  })
+})
