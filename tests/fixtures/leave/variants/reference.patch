+<?php
+
+namespace App\Leave;
+
+use App\Entity\LeaveRequest;
+use App\Entity\LeaveStatus;
+
+final readonly class LeaveBalance
+{
+    public function __construct(
+        public int $allowance,
+        public int $approved,
+        public int $pending,
+    ) {
+    }
+
+    /**
+     * @param list<LeaveRequest> $requestsOfYear
+     */
+    public static function of(int $allowance, array $requestsOfYear): self
+    {
+        $daysWith = static fn (LeaveStatus $status) => array_sum(array_map(
+            static fn (LeaveRequest $request) => $status === $request->getStatus() ? $request->getWorkingDays() : 0,
+            $requestsOfYear,
+        ));
+
+        return new self($allowance, $daysWith(LeaveStatus::Approved), $daysWith(LeaveStatus::Pending));
+    }
+
+    public function remaining(): int
+    {
+        return $this->allowance - $this->approved - $this->pending;
+    }
+}
