+<?php
+
+namespace App\Leave;
+
+use App\Repository\PublicHolidayRepository;
+
+final readonly class WorkingDays
+{
+    public function __construct(private PublicHolidayRepository $holidays)
+    {
+    }
+
+    /**
+     * Monday to Friday between both dates inclusive, without public holidays.
+     */
+    public function count(\DateTimeImmutable $from, \DateTimeImmutable $to): int
+    {
+        $holidays = array_map(
+            static fn ($holiday) => $holiday->getDate()->format('Y-m-d'),
+            $this->holidays->findBetween($from, $to),
+        );
+
+        $days = 0;
+        for ($day = $from; $day <= $to; $day = $day->modify('+1 day')) {
+            if ((int) $day->format('N') <= 5 && !\in_array($day->format('Y-m-d'), $holidays, true)) {
+                ++$days;
+            }
+        }
+
+        return $days;
+    }
+}
diff --git a/backend/src/Repository/LeaveRequestRepository.php b/backend/src/Repository/LeaveRequestRepository.php
