--- /dev/null
+++ b/backend/src/Leave/LeaveRequests.php
@@ -0,0 +1,117 @@
+<?php
+
+namespace App\Leave;
+
+use App\Entity\Employee;
+use App\Entity\LeaveRequest;
+use App\Repository\LeaveRequestRepository;
+use Doctrine\ORM\EntityManagerInterface;
+use Psr\Clock\ClockInterface;
+use Symfony\Component\Mailer\MailerInterface;
+use Symfony\Component\Mime\Email;
+
+/**
+ * What employees and managers do with leave requests.
+ */
+final readonly class LeaveRequests
+{
+    private const MAX_COMMENT_LENGTH = 500;
+
+    public function __construct(
+        private LeaveRequestRepository $requests,
+        private WorkingDays $workingDays,
+        private EntityManagerInterface $entityManager,
+        private MailerInterface $mailer,
+        private ClockInterface $clock,
+    ) {
+    }
+
+    public function balance(Employee $employee, int $year): LeaveBalance
+    {
+        return LeaveBalance::of($employee->getAnnualLeaveDays(), $this->requests->findOfEmployeeInYear($employee, $year));
+    }
+
+    public function submit(Employee $employee, \DateTimeImmutable $start, \DateTimeImmutable $end, ?string $comment): LeaveRequest
+    {
+        if ($start > $end) {
+            throw new LeaveRequestRefused('Дата початку пізніша за дату завершення.');
+        }
+        if ($start < $this->today()) {
+            throw new LeaveRequestRefused('Не можна подати заяву на минулу дату.');
+        }
+        if ($start->format('Y') !== $end->format('Y')) {
+            throw new LeaveRequestRefused('Заява не може охоплювати два роки.');
+        }
+        $workingDays = $this->workingDays->count($start, $end);
+        if (0 === $workingDays) {
+            throw new LeaveRequestRefused('У вибраному періоді немає робочих днів.');
+        }
+        if (mb_strlen($comment ?? '') > self::MAX_COMMENT_LENGTH) {
+            throw new LeaveRequestRefused('Коментар не довший за 500 символів.');
+        }
+        if ($this->requests->hasOverlapping($employee, $start, $end)) {
+            throw new LeaveRequestRefused('Період перетинається з іншою заявою.');
+        }
+        $remaining = $this->balance($employee, (int) $start->format('Y'))->remaining();
+        if ($workingDays > $remaining) {
+            throw new LeaveRequestRefused("Недостатньо днів відпустки: залишилось $remaining.");
+        }
+
+        $request = new LeaveRequest($employee, $start, $end, $workingDays, $comment);
+        $this->entityManager->persist($request);
+        $this->entityManager->flush();
+
+        $manager = $employee->getTeam()->getManager();
+        if (null !== $manager && !$employee->isManager()) {
+            $this->mailer->send((new Email())
+                ->to($manager->getEmail())
+                ->subject('Нова заява на відпустку')
+                ->text(\sprintf('%s просить відпустку %s, робочих днів: %d.', $employee->getName(), $this->period($request), $workingDays)));
+        }
+
+        return $request;
+    }
+
+    public function cancel(LeaveRequest $request): void
+    {
+        $request->cancel($this->today());
+        $this->entityManager->flush();
+    }
+
+    public function approve(LeaveRequest $request): void
+    {
+        $request->approve();
+        $this->entityManager->flush();
+        $this->notifyEmployee($request, 'Заяву погоджено', "Вашу відпустку {$this->period($request)} погоджено.");
+    }
+
+    public function reject(LeaveRequest $request, string $reason): void
+    {
+        if ('' === trim($reason)) {
+            throw new LeaveRequestRefused('Вкажіть причину відмови.');
+        }
+        $request->reject($reason);
+        $this->entityManager->flush();
+        $this->notifyEmployee($request, 'Заяву відхилено', "Вашу відпустку {$this->period($request)} відхилено. Причина: $reason");
+    }
+
+    public function isCancellable(LeaveRequest $request): bool
+    {
+        return $request->isCancellable($this->today());
+    }
+
+    private function notifyEmployee(LeaveRequest $request, string $subject, string $text): void
+    {
+        $this->mailer->send((new Email())->to($request->getEmployee()->getEmail())->subject($subject)->text($text));
+    }
+
+    private function period(LeaveRequest $request): string
+    {
+        return $request->getStartDate()->format('d.m.Y').' – '.$request->getEndDate()->format('d.m.Y');
+    }
+
+    private function today(): \DateTimeImmutable
+    {
+        return $this->clock->now()->setTime(0, 0);
+    }
+}
