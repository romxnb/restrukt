+<?php
+
+namespace App\Controller;
+
+use App\Dto\LeaveRequestRejection;
+use App\Entity\Employee;
+use App\Entity\LeaveRequest;
+use App\Leave\LeaveRequests;
+use App\Repository\LeaveRequestRepository;
+use Symfony\Bridge\Doctrine\Attribute\MapEntity;
+use Symfony\Bundle\FrameworkBundle\Controller\AbstractController;
+use Symfony\Component\HttpFoundation\JsonResponse;
+use Symfony\Component\HttpKernel\Attribute\MapRequestPayload;
+use Symfony\Component\Routing\Attribute\Route;
+use Symfony\Component\Security\Http\Attribute\CurrentUser;
+
+#[Route('/api/team/leave-requests')]
+final class TeamLeaveRequestController extends AbstractController
+{
+    private const MANAGERS_ONLY = 'Доступно лише керівнику команди.';
+
+    public function __construct(private readonly LeaveRequests $leaveRequests)
+    {
+    }
+
+    #[Route('', methods: ['GET'])]
+    public function pending(#[CurrentUser] Employee $me, LeaveRequestRepository $requests): JsonResponse
+    {
+        if (!$me->isManager()) {
+            throw $this->createAccessDeniedException(self::MANAGERS_ONLY);
+        }
+
+        return $this->json(array_map(
+            static fn (LeaveRequest $request) => [
+                'id' => $request->getId(),
+                'employee' => ['id' => $request->getEmployee()->getId(), 'name' => $request->getEmployee()->getName()],
+                'startDate' => $request->getStartDate()->format('Y-m-d'),
+                'endDate' => $request->getEndDate()->format('Y-m-d'),
+                'workingDays' => $request->getWorkingDays(),
+                'comment' => $request->getComment(),
+            ],
+            $requests->findPendingForManager($me),
+        ));
+    }
+
+    #[Route('/{id}/approve', methods: ['POST'])]
+    public function approve(
+        #[CurrentUser] Employee $me,
+        #[MapEntity(message: 'Заяву не знайдено.')] LeaveRequest $request,
+    ): JsonResponse {
+        $this->denyUnlessManagerOf($me, $request);
+        $this->leaveRequests->approve($request);
+
+        return $this->decision($request);
+    }
+
+    #[Route('/{id}/reject', methods: ['POST'])]
+    public function reject(
+        #[CurrentUser] Employee $me,
+        #[MapEntity(message: 'Заяву не знайдено.')] LeaveRequest $request,
+        #[MapRequestPayload] LeaveRequestRejection $rejection = new LeaveRequestRejection(),
+    ): JsonResponse {
+        $this->denyUnlessManagerOf($me, $request);
+        $this->leaveRequests->reject($request, $rejection->reason);
+
+        return $this->decision($request);
+    }
+
+    private function denyUnlessManagerOf(Employee $me, LeaveRequest $request): void
+    {
+        if ($request->getEmployee()->getTeam()->getManager() !== $me) {
+            throw $this->createAccessDeniedException(self::MANAGERS_ONLY);
+        }
+    }
+
+    private function decision(LeaveRequest $request): JsonResponse
+    {
+        return $this->json([
+            'id' => $request->getId(),
+            'status' => $request->getStatus()->value,
+            'rejectionReason' => $request->getRejectionReason(),
+        ]);
+    }
+}
