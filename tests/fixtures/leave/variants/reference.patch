+<script setup lang="ts">
+import { onMounted, ref } from 'vue'
+import { approveLeaveRequest, fetchTeamLeaveRequests, rejectLeaveRequest, type TeamLeaveRequest } from '@/api/leave'
+import { formatPeriod } from '@/format'
+
+const requests = ref<TeamLeaveRequest[]>([])
+const rejectingId = ref<number | null>(null)
+const reason = ref('')
+const error = ref('')
+
+async function load() {
+  try {
+    requests.value = await fetchTeamLeaveRequests()
+  } catch (e) {
+    error.value = (e as Error).message
+  }
+}
+
+async function decide(decision: () => Promise<unknown>) {
+  error.value = ''
+  try {
+    await decision()
+    rejectingId.value = null
+    reason.value = ''
+    await load()
+  } catch (e) {
+    error.value = (e as Error).message
+  }
+}
+
+function startRejecting(request: TeamLeaveRequest) {
+  rejectingId.value = request.id
+  reason.value = ''
+}
+
+onMounted(load)
+</script>
+
+<template>
+  <h1>Заяви команди</h1>
+  <p v-if="error" class="error" role="alert">{{ error }}</p>
+  <p v-if="requests.length === 0">Заяв на розгляді немає.</p>
