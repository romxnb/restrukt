@@ -0,0 +1,91 @@
+<?php
+
+namespace App\Controller;
+
+use App\Dto\LeaveRequestSubmission;
+use App\Entity\Employee;
+use App\Entity\LeaveRequest;
+use App\Leave\LeaveRequests;
+use App\Repository\LeaveRequestRepository;
+use Psr\Clock\ClockInterface;
+use Symfony\Bridge\Doctrine\Attribute\MapEntity;
+use Symfony\Bundle\FrameworkBundle\Controller\AbstractController;
+use Symfony\Component\HttpFoundation\JsonResponse;
+use Symfony\Component\HttpFoundation\Response;
+use Symfony\Component\HttpKernel\Attribute\MapQueryParameter;
+use Symfony\Component\HttpKernel\Attribute\MapRequestPayload;
+use Symfony\Component\Routing\Attribute\Route;
+use Symfony\Component\Security\Http\Attribute\CurrentUser;
+
+#[Route('/api/leave-requests')]
+final class LeaveRequestController extends AbstractController
+{
+    public function __construct(private readonly LeaveRequests $leaveRequests)
+    {
+    }
+
+    #[Route('', methods: ['GET'])]
+    public function mine(
+        #[CurrentUser] Employee $me,
+        LeaveRequestRepository $requests,
+        ClockInterface $clock,
+        #[MapQueryParameter] ?int $year = null,
+    ): JsonResponse {
+        $year ??= (int) $clock->now()->format('Y');
+        $balance = $this->leaveRequests->balance($me, $year);
+
+        return $this->json([
+            'year' => $year,
+            'balance' => [
+                'allowance' => $balance->allowance,
+                'approved' => $balance->approved,
+                'pending' => $balance->pending,
+                'remaining' => $balance->remaining(),
+            ],
+            'requests' => array_map($this->toJson(...), $requests->findOfEmployeeInYear($me, $year)),
+        ]);
+    }
+
+    #[Route('', methods: ['POST'])]
+    public function submit(#[CurrentUser] Employee $me, #[MapRequestPayload] LeaveRequestSubmission $submission): JsonResponse
+    {
+        $request = $this->leaveRequests->submit(
+            $me,
+            new \DateTimeImmutable($submission->startDate),
+            new \DateTimeImmutable($submission->endDate),
+            $submission->comment,
+        );
+
+        return $this->json($this->toJson($request), Response::HTTP_CREATED);
+    }
+
+    #[Route('/{id}/cancel', methods: ['POST'])]
+    public function cancel(
+        #[CurrentUser] Employee $me,
+        #[MapEntity(message: 'Заяву не знайдено.')] LeaveRequest $request,
+    ): JsonResponse {
+        if ($request->getEmployee() !== $me) {
+            throw $this->createNotFoundException('Заяву не знайдено.');
+        }
+        $this->leaveRequests->cancel($request);
+
+        return $this->json($this->toJson($request));
+    }
+
+    /**
+     * @return array<string, mixed>
+     */
+    private function toJson(LeaveRequest $request): array
+    {
+        return [
+            'id' => $request->getId(),
+            'startDate' => $request->getStartDate()->format('Y-m-d'),
+            'endDate' => $request->getEndDate()->format('Y-m-d'),
+            'workingDays' => $request->getWorkingDays(),
+            'status' => $request->getStatus()->value,
+            'comment' => $request->getComment(),
+            'rejectionReason' => $request->getRejectionReason(),
+            'cancellable' => $this->leaveRequests->isCancellable($request),
+        ];
+    }
+}
