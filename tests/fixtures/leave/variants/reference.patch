+++ b/backend/src/Repository/LeaveRequestRepository.php
@@ -0,0 +1,74 @@
+<?php
+
+namespace App\Repository;
+
+use App\Entity\Employee;
+use App\Entity\LeaveRequest;
+use App\Entity\LeaveStatus;
+use Doctrine\Bundle\DoctrineBundle\Repository\ServiceEntityRepository;
+use Doctrine\Persistence\ManagerRegistry;
+
+/**
+ * @extends ServiceEntityRepository<LeaveRequest>
+ */
+class LeaveRequestRepository extends ServiceEntityRepository
+{
+    public function __construct(ManagerRegistry $registry)
+    {
+        parent::__construct($registry, LeaveRequest::class);
+    }
+
+    /**
+     * @return list<LeaveRequest>
+     */
+    public function findOfEmployeeInYear(Employee $employee, int $year): array
+    {
+        return $this->createQueryBuilder('request')
+            ->where('request.employee = :employee')
+            ->andWhere('request.startDate BETWEEN :from AND :to')
+            ->setParameter('employee', $employee)
+            ->setParameter('from', "$year-01-01")
+            ->setParameter('to', "$year-12-31")
+            ->orderBy('request.startDate', 'ASC')
+            ->getQuery()
+            ->getResult();
+    }
+
+    /**
+     * Whether a pending or approved request of the employee shares a day with the period.
+     */
+    public function hasOverlapping(Employee $employee, \DateTimeImmutable $from, \DateTimeImmutable $to): bool
+    {
+        return (bool) $this->createQueryBuilder('request')
+            ->select('COUNT(request.id)')
+            ->where('request.employee = :employee')
+            ->andWhere('request.status IN (:statuses)')
+            ->andWhere('request.startDate <= :to AND request.endDate >= :from')
+            ->setParameter('employee', $employee)
+            ->setParameter('statuses', [LeaveStatus::Pending, LeaveStatus::Approved])
+            ->setParameter('from', $from->format('Y-m-d'))
+            ->setParameter('to', $to->format('Y-m-d'))
+            ->getQuery()
+            ->getSingleScalarResult();
+    }
+
+    /**
+     * Pending requests of the manager's team, without the manager's own.
+     *
+     * @return list<LeaveRequest>
+     */
+    public function findPendingForManager(Employee $manager): array
+    {
+        return $this->createQueryBuilder('request')
+            ->join('request.employee', 'employee')
+            ->where('employee.team = :team')
+            ->andWhere('employee != :manager')
+            ->andWhere('request.status = :pending')
+            ->setParameter('team', $manager->getTeam())
+            ->setParameter('manager', $manager)
+            ->setParameter('pending', LeaveStatus::Pending)
+            ->orderBy('request.startDate', 'ASC')
+            ->getQuery()
+            ->getResult();
+    }
+}
