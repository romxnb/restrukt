+<?php
+
+namespace App\Entity;
+
+use App\Leave\LeaveRequestRefused;
+use App\Repository\LeaveRequestRepository;
+use Doctrine\DBAL\Types\Types;
+use Doctrine\ORM\Mapping as ORM;
+
+#[ORM\Entity(repositoryClass: LeaveRequestRepository::class)]
+class LeaveRequest
+{
+    #[ORM\Id]
+    #[ORM\GeneratedValue]
+    #[ORM\Column]
+    private ?int $id = null;
+
+    #[ORM\Column(enumType: LeaveStatus::class)]
+    private LeaveStatus $status = LeaveStatus::Pending;
+
+    #[ORM\Column(length: 500, nullable: true)]
+    private ?string $rejectionReason = null;
+
+    public function __construct(
+        #[ORM\ManyToOne]
+        #[ORM\JoinColumn(nullable: false)]
+        private Employee $employee,
+        #[ORM\Column(type: Types::DATE_IMMUTABLE)]
+        private \DateTimeImmutable $startDate,
+        #[ORM\Column(type: Types::DATE_IMMUTABLE)]
+        private \DateTimeImmutable $endDate,
+        #[ORM\Column]
+        private int $workingDays,
+        #[ORM\Column(length: 500, nullable: true)]
+        private ?string $comment = null,
+    ) {
+        if ($employee->isManager()) {
+            $this->status = LeaveStatus::Approved;
+        }
+    }
+
+    public function approve(): void
+    {
+        $this->assertPending();
+        $this->status = LeaveStatus::Approved;
+    }
+
+    public function reject(string $reason): void
+    {
+        $this->assertPending();
+        $this->status = LeaveStatus::Rejected;
+        $this->rejectionReason = $reason;
+    }
+
+    public function cancel(\DateTimeImmutable $today): void
+    {
+        if (!$this->isCancellable($today)) {
+            throw new LeaveRequestRefused('Скасувати можна лише заяву, що ще не почалася.');
+        }
+        $this->status = LeaveStatus::Cancelled;
+    }
+
+    public function isCancellable(\DateTimeImmutable $today): bool
+    {
+        return $this->status->usesAllowance() && $this->startDate > $today;
+    }
+
+    public function getId(): ?int
+    {
+        return $this->id;
+    }
+
+    public function getEmployee(): Employee
+    {
+        return $this->employee;
+    }
+
+    public function getStartDate(): \DateTimeImmutable
+    {
+        return $this->startDate;
+    }
+
+    public function getEndDate(): \DateTimeImmutable
+    {
+        return $this->endDate;
+    }
+
+    public function getWorkingDays(): int
+    {
+        return $this->workingDays;
+    }
+
+    public function getStatus(): LeaveStatus
+    {
+        return $this->status;
+    }
+
+    public function getComment(): ?string
+    {
+        return $this->comment;
+    }
+
+    public function getRejectionReason(): ?string
+    {
+        return $this->rejectionReason;
+    }
+
+    private function assertPending(): void
+    {
+        if (LeaveStatus::Pending !== $this->status) {
+            throw new LeaveRequestRefused('Заяву вже розглянуто.');
+        }
+    }
+}
