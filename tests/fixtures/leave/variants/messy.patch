+<?php
+
+namespace App\Notification;
+
+use App\Entity\Leave;
+use Symfony\Component\DependencyInjection\Attribute\AutowireIterator;
+
+/**
+ * Sends notifications about leave requests using registered strategies.
+ */
+class NotificationManager
+{
+    /**
+     * @param iterable<NotificationStrategyInterface> $strategies
+     */
+    public function __construct(
+        #[AutowireIterator(NotificationStrategyInterface::class)]
+        private iterable $strategies,
+    ) {
+    }
+
+    public function notify(string $type, Leave $leave, array $context = []): void
+    {
+        foreach ($this->strategies as $strategy) {
+            if ($strategy->supports($type)) {
+                $strategy->send($leave, $type, $context);
+            }
+        }
+    }
+}
