+<?php
+
+namespace App\Service;
+
+use App\Entity\Employee;
+
+/**
+ * Resolves status of new leave request.
+ */
+class LeaveStatusResolver
+{
+    public static function resolve(Employee $employee): string
+    {
+        // manager does not need approval
+        if ($employee->isManager()) {
+            return 'approved';
+        }
+
+        return 'pending';
+    }
+}
