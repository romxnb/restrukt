+<?php
+
+namespace App\Helper;
+
+class DateHelper
+{
+    /**
+     * Calculates working days between two dates (including both).
+     *
+     * @param string[] $holidays dates in Y-m-d format
+     */
+    public static function calc(\DateTimeInterface $from, \DateTimeInterface $to, array $holidays = []): int
+    {
+        $count = 0;
+        $current = \DateTime::createFromInterface($from);
+
+        while ($current <= $to) {
+            $dayOfWeek = (int) $current->format('N');
+            // 6 = saturday, 7 = sunday
+            if ($dayOfWeek < 6 && !in_array($current->format('Y-m-d'), $holidays)) {
+                ++$count;
+            }
+            $current->modify('+1 day');
+        }
+
+        return $count;
+    }
+
+    public static function toString(?\DateTimeInterface $date): string
+    {
+        return $date ? $date->format('d.m.Y') : '';
+    }
+}
