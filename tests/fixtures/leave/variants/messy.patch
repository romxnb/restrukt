+<?php
+
+namespace App\Notification;
+
+use App\Entity\Leave;
+use App\Helper\DateHelper;
+use Symfony\Component\Mailer\MailerInterface;
+use Symfony\Component\Mime\Email;
+
+/**
+ * Notifies employee about decision on his absence.
+ */
+class EmployeeNotificationStrategy implements NotificationStrategyInterface
+{
+    public function __construct(private MailerInterface $mailer)
+    {
+    }
+
+    public function supports(string $type): bool
+    {
+        return in_array($type, [self::TYPE_APPROVED, self::TYPE_REJECTED]);
+    }
+
+    public function send(Leave $absence, string $type, array $context = []): void
+    {
+        $period = DateHelper::toString($absence->getStartDate()).' – '.DateHelper::toString($absence->getEndDate());
+
+        if ('approved' == $type) {
+            $subject = 'Заяву погоджено';
+            $text = "Вашу заяву на відпустку ($period) погоджено.";
+        } else {
+            $subject = 'Заяву відхилено';
+            $text = "Вашу заяву на відпустку ($period) відхилено.\nПричина: ".($context['reason'] ?? $absence->getRejectionReason());
+        }
+
+        $email = (new Email())
+            ->to($absence->getEmployee()->getEmail())
+            ->subject($subject)
+            ->text($text);
+
+        $this->mailer->send($email);
+    }
+}
