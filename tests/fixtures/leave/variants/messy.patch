+<?php
+
+namespace App\Factory;
+
+use App\Dto\LeaveRequestDTO;
+use App\Entity\Employee;
+use App\Entity\Leave;
+use App\Helper\DateHelper;
+use App\Repository\PublicHolidayRepository;
+use Psr\Clock\ClockInterface;
+
+class LeaveFactory
+{
+    public function __construct(
+        private PublicHolidayRepository $publicHolidayRepository,
+        private ClockInterface $clock,
+    ) {
+    }
+
+    /**
+     * Creates new leave from DTO.
+     */
+    public function create(LeaveRequestDTO $dto, Employee $employee): Leave
+    {
+        $start = new \DateTimeImmutable((string) $dto->startDate);
+        $end = new \DateTimeImmutable((string) $dto->endDate);
+
+        $holidays = [];
+        foreach ($this->publicHolidayRepository->findBetween($start, $end) as $holiday) {
+            $holidays[] = $holiday->getDate()->format('Y-m-d');
+        }
+
+        $leave = new Leave();
+        $leave->setEmployee($employee);
+        $leave->setStartDate($start);
+        $leave->setEndDate($end);
+        $leave->setDays(DateHelper::calc($start, $end, $holidays));
+        $leave->setComment($dto->comment);
+        $leave->setStatus('pending');
+        $leave->setRejectionReason(null);
+        $leave->setCreatedAt($this->clock->now());
+
+        return $leave;
+    }
+}
