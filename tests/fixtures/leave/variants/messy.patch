+<?php
+
+namespace App\Notification;
+
+use App\Entity\Leave;
+use Symfony\Component\Mailer\MailerInterface;
+use Symfony\Component\Mime\Email;
+
+/**
+ * Notifies team manager about new leave request.
+ */
+class ManagerNotificationStrategy implements NotificationStrategyInterface
+{
+    public function __construct(private MailerInterface $mailer)
+    {
+    }
+
+    public function supports(string $type): bool
+    {
+        return self::TYPE_NEW_REQUEST == $type;
+    }
+
+    public function send(Leave $leave, string $type, array $context = []): void
+    {
+        $employee = $leave->getEmployee();
+        $manager = $employee->getTeam()->getManager();
+
+        // no manager - nobody to notify
+        if (!$manager) {
+            return;
+        }
+
+        $text = $employee->getName().' подає заяву на відпустку з '.$leave->getStartDate()->format('d.m.Y').' по '.$leave->getEndDate()->format('d.m.Y').".\n";
+        $text .= 'Робочих днів: '.$leave->getDays().".\n";
+        if ($leave->getComment()) {
+            $text .= 'Коментар: '.$leave->getComment()."\n";
+        }
+
+        $email = (new Email())
+            ->to($manager->getEmail())
+            ->subject('Нова заява на відпустку')
+            ->text($text);
+
+        $this->mailer->send($email);
+    }
+}
