+++ b/frontend/src/pages/LeavePage.vue
@@ -0,0 +1,426 @@
+<script setup lang="ts">
+import { onMounted, ref, watch } from 'vue'
+import { getErrorMessage } from '@/utils'
+
+const props = withDefaults(defineProps<{ mode?: string }>(), { mode: 'my' })
+
+// eslint-disable-next-line @typescript-eslint/no-explicit-any
+const leaves = ref<any[]>([])
+// eslint-disable-next-line @typescript-eslint/no-explicit-any
+const balance = ref<any>(null)
+// eslint-disable-next-line @typescript-eslint/no-explicit-any
+const teamRequests = ref<any[]>([])
+const loading = ref(false)
+const error = ref('')
+
+// new request form
+const startDate = ref('')
+const endDate = ref('')
+const comment = ref('')
+const sending = ref(false)
+
+// reject form
+const rejectId = ref<number | null>(null)
+const rejectReason = ref('')
+const deciding = ref(false)
+
+function formatDate(date: string) {
+  if (!date) {
+    return ''
+  }
+  const parts = date.split('-')
+  return parts[2] + '.' + parts[1] + '.' + parts[0]
+}
+
+async function loadLeaves() {
+  loading.value = true
+  try {
+    const res = await fetch('/api/leave-requests', {
+      headers: {
+        'Content-Type': 'application/json',
+        'X-Employee-Id': localStorage.getItem('employeeId') || '',
+      },
+    })
+    const data = await res.json()
+    if (!res.ok) {
+      error.value = data.error || 'Не вдалося завантажити заяви.'
+      return
+    }
+    leaves.value = data.requests
+    balance.value = data.balance
+  } catch (e) {
+    console.log(e)
+    error.value = 'Не вдалося завантажити заяви.'
+  } finally {
+    loading.value = false
+  }
+}
+
+async function loadTeamRequests() {
+  loading.value = true
+  try {
+    const res = await fetch('/api/team/leave-requests', {
+      headers: {
+        'Content-Type': 'application/json',
+        'X-Employee-Id': localStorage.getItem('employeeId') || '',
+      },
+    })
+    const data = await res.json()
+    if (!res.ok) {
+      error.value = data.error || 'Не вдалося завантажити заяви команди.'
+      return
+    }
+    teamRequests.value = data
+  } catch (e) {
+    console.log(e)
+    error.value = 'Не вдалося завантажити заяви команди.'
+  } finally {
+    loading.value = false
+  }
+}
+
+async function submit() {
+  error.value = ''
+  sending.value = true
+  try {
+    // eslint-disable-next-line @typescript-eslint/no-explicit-any
+    const body: any = {
+      startDate: startDate.value,
+      endDate: endDate.value,
+    }
+    if (comment.value) {
+      body.comment = comment.value
+    }
+    const res = await fetch('/api/leave-requests', {
+      method: 'POST',
+      headers: {
+        'Content-Type': 'application/json',
+        'X-Employee-Id': localStorage.getItem('employeeId') || '',
+      },
+      body: JSON.stringify(body),
+    })
+    if (!res.ok) {
+      const data = await res.json().catch(() => ({}))
+      error.value = data.error || 'Не вдалося подати заяву.'
+      return
+    }
+    // clear form
+    startDate.value = ''
+    endDate.value = ''
+    comment.value = ''
+    await loadLeaves()
+  } catch (e) {
+    error.value = getErrorMessage(e)
+  } finally {
+    sending.value = false
+  }
+}
+
+async function cancelLeave(id: number) {
+  error.value = ''
+  try {
+    const res = await fetch('/api/leave-requests/' + id + '/cancel', {
+      method: 'POST',
+      headers: {
+        'Content-Type': 'application/json',
+        'X-Employee-Id': localStorage.getItem('employeeId') || '',
+      },
+    })
+    if (!res.ok) {
+      const data = await res.json().catch(() => ({}))
+      error.value = data.error || 'Не вдалося скасувати заяву.'
+      return
+    }
+    await loadLeaves()
+  } catch (e) {
+    error.value = getErrorMessage(e)
+  }
+}
+
+async function approve(id: number) {
+  error.value = ''
+  deciding.value = true
+  try {
+    const res = await fetch(`/api/team/leave-requests/${id}/approve`, {
+      method: 'POST',
+      headers: {
+        'Content-Type': 'application/json',
+        'X-Employee-Id': localStorage.getItem('employeeId') || '',
+      },
+    })
+    if (!res.ok) {
+      const data = await res.json().catch(() => ({}))
+      error.value = data.error || 'Не вдалося погодити заяву.'
+      return
+    }
+    // remove approved request from list
+    teamRequests.value = teamRequests.value.filter((r) => r.id !== id)
+  } catch (e) {
+    error.value = getErrorMessage(e)
+  } finally {
+    deciding.value = false
+  }
+}
+
+function startReject(id: number) {
+  rejectId.value = id
+  rejectReason.value = ''
+}
+
+async function confirmReject(id: number) {
+  error.value = ''
+  deciding.value = true
+  try {
+    const res = await fetch(`/api/team/leave-requests/${id}/reject`, {
+      method: 'POST',
+      headers: {
+        'Content-Type': 'application/json',
+        'X-Employee-Id': localStorage.getItem('employeeId') || '',
+      },
+      body: JSON.stringify({ reason: rejectReason.value }),
+    })
+    if (!res.ok) {
+      const data = await res.json().catch(() => ({}))
+      error.value = data.error || 'Не вдалося відхилити заяву.'
+      return
+    }
+    // remove rejected request from list
+    teamRequests.value = teamRequests.value.filter((r) => r.id !== id)
+    rejectId.value = null
+    rejectReason.value = ''
+  } catch (e) {
+    error.value = getErrorMessage(e)
+  } finally {
+    deciding.value = false
+  }
+}
+
+function load() {
+  error.value = ''
+  if (props.mode === 'team') {
+    loadTeamRequests()
+  } else {
+    loadLeaves()
+  }
+}
+
+onMounted(() => {
+  load()
+})
+
+// same component is used for /leave and /team/leave
+watch(
+  () => props.mode,
+  () => {
+    load()
+  },
+)
+</script>
+
+<template>
+  <div class="leave-page">
+    <template v-if="mode !== 'team'">
+      <h1>Мої відпустки</h1>
+      <p v-if="error" class="error" role="alert">{{ error }}</p>
+
+      <div v-if="balance" class="balance">
+        <div class="balance-item">Річна норма: {{ balance.allowance }}</div>
+        <div class="balance-item">Погоджено: {{ balance.approved }}</div>
+        <div class="balance-item">На розгляді: {{ balance.pending }}</div>
+        <div class="balance-item balance-remaining">Залишок: {{ balance.remaining }}</div>
+      </div>
+
+      <h2>Нова заява</h2>
+      <form class="leave-form" @submit.prevent="submit">
+        <label>
+          Дата початку
+          <input v-model="startDate" type="date" name="startDate" />
+        </label>
+        <label>
+          Дата завершення
+          <input v-model="endDate" type="date" name="endDate" />
+        </label>
+        <label class="comment-field">
+          Коментар
+          <textarea v-model="comment" name="comment" rows="2"></textarea>
+        </label>
+        <button type="submit" :disabled="sending">Подати заяву</button>
+      </form>
+
+      <h2>Заяви цього року</h2>
+      <p v-if="!loading && leaves.length === 0" class="empty">Заяв цього року немає.</p>
+      <ul v-else class="leave-list">
+        <li v-for="item in leaves" :key="item.id" class="leave-item">
+          <span class="period">{{ formatDate(item.startDate) }} – {{ formatDate(item.endDate) }}</span>
+          <span class="days">Робочих днів: {{ item.workingDays }}</span>
+          <span v-if="item.status === 'pending'" class="status status-pending">На розгляді</span>
+          <span v-else-if="item.status === 'approved'" class="status status-approved">Погоджено</span>
+          <span v-else-if="item.status === 'rejected'" class="status status-rejected">Відхилено</span>
