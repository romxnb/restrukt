+++ b/backend/src/Controller/LeaveController.php
@@ -0,0 +1,392 @@
+<?php
+
+namespace App\Controller;
+
+use App\Entity\Employee;
+use App\Entity\Leave;
+use App\Factory\LeaveFactory;
+use App\Mapper\LeaveRequestMapper;
+use App\Notification\NotificationManager;
+use App\Repository\LeaveRepository;
+use App\Repository\PublicHolidayRepository;
+use App\Service\LeaveServiceInterface;
+use App\Service\LeaveStatusResolver;
+use Doctrine\ORM\EntityManagerInterface;
+use Psr\Clock\ClockInterface;
+use Symfony\Bundle\FrameworkBundle\Controller\AbstractController;
+use Symfony\Component\HttpFoundation\JsonResponse;
+use Symfony\Component\HttpFoundation\Request;
+use Symfony\Component\Routing\Attribute\Route;
+
+#[Route('/api')]
+class LeaveController extends AbstractController
+{
+    public function __construct(
+        private EntityManagerInterface $em,
+        private LeaveServiceInterface $leaveService,
+        private LeaveRepository $leaveRepository,
+        private PublicHolidayRepository $holidayRepository,
+        private ClockInterface $clock,
+        private NotificationManager $notificationManager,
+        private LeaveRequestMapper $mapper,
+        private LeaveFactory $leaveFactory,
+    ) {
+    }
+
+    /**
+     * My leave requests for year + balance.
+     */
+    #[Route('/leave-requests', methods: ['GET'])]
+    public function list(Request $request): JsonResponse
+    {
+        /** @var Employee $user */
+        $user = $this->getUser();
+
+        // get year from query, current year by default
+        $year = $request->query->get('year');
+        if (!$year) {
+            $year = $this->clock->now()->format('Y');
+        }
+        $year = (int) $year;
+
+        $leaves = $this->leaveService->getVacations($user, $year);
+
+        $approved = 0;
+        $pending = 0;
+        $requests = [];
+        foreach ($leaves as $leave) {
+            if ('approved' == $leave->getStatus()) {
+                $approved = $approved + $leave->getDays();
+            } elseif ('pending' == $leave->getStatus()) {
+                $pending = $pending + $leave->getDays();
+            }
+            $requests[] = $this->leaveToArray($leave);
+        }
+
+        return new JsonResponse([
+            'year' => $year,
+            'balance' => [
+                'allowance' => $user->getAnnualLeaveDays(),
+                'approved' => $approved,
+                'pending' => $pending,
+                'remaining' => $user->getAnnualLeaveDays() - $approved - $pending,
+            ],
+            'requests' => $requests,
+        ]);
+    }
+
+    /**
+     * Submit new leave request.
+     */
+    #[Route('/leave-requests', methods: ['POST'])]
+    public function create(Request $request): JsonResponse
+    {
+        /** @var Employee $user */
+        $user = $this->getUser();
+
+        $data = json_decode($request->getContent(), true);
+        if (!is_array($data)) {
+            $data = [];
+        }
+
+        $startDate = $data['startDate'] ?? null;
+        $endDate = $data['endDate'] ?? null;
+
+        // validate dates
+        if (!is_string($startDate) || !preg_match('/^\d{4}-\d{2}-\d{2}$/D', $startDate)) {
+            return new JsonResponse(['error' => 'Вкажіть дати у форматі РРРР-ММ-ДД.'], 422);
+        }
+        if (!is_string($endDate) || !preg_match('/^\d{4}-\d{2}-\d{2}$/D', $endDate)) {
+            return new JsonResponse(['error' => 'Вкажіть дати у форматі РРРР-ММ-ДД.'], 422);
+        }
+        $s = explode('-', $startDate);
+        if (!checkdate((int) $s[1], (int) $s[2], (int) $s[0])) {
+            return new JsonResponse(['error' => 'Вкажіть дати у форматі РРРР-ММ-ДД.'], 422);
+        }
+        $e = explode('-', $endDate);
+        if (!checkdate((int) $e[1], (int) $e[2], (int) $e[0])) {
+            return new JsonResponse(['error' => 'Вкажіть дати у форматі РРРР-ММ-ДД.'], 422);
+        }
+
+        if ($startDate > $endDate) {
+            return new JsonResponse(['error' => 'Дата початку пізніша за дату завершення.'], 422);
+        }
+
+        // get today
+        $today = $this->clock->now()->format('Y-m-d');
+        if ($startDate < $today) {
+            return new JsonResponse(['error' => 'Не можна подати заяву на минулу дату.'], 422);
+        }
+
+        if (substr($startDate, 0, 4) != substr($endDate, 0, 4)) {
+            return new JsonResponse(['error' => 'Заява не може охоплювати два роки.'], 422);
+        }
+
+        $days = $this->countDays(new \DateTimeImmutable($startDate), new \DateTimeImmutable($endDate));
+        if (0 == $days) {
+            return new JsonResponse(['error' => 'У вибраному періоді немає робочих днів.'], 422);
+        }
+
+        if (isset($data['comment']) && mb_strlen($data['comment']) > 500) {
+            return new JsonResponse(['error' => 'Коментар не довший за 500 символів.'], 422);
+        }
+
+        // check if period overlaps with other requests
+        $myLeaves = $this->leaveRepository->findBy(['employee' => $user]);
+        foreach ($myLeaves as $l) {
+            if ('cancelled' == $l->getStatus() || 'rejected' == $l->getStatus()) {
+                continue;
+            }
+            if ($l->getStartDate()->format('Y-m-d') <= $endDate && $l->getEndDate()->format('Y-m-d') >= $startDate) {
+                return new JsonResponse(['error' => 'Період перетинається з іншою заявою.'], 422);
+            }
+        }
+
+        $balance = $this->fetchBalance($user, (int) substr($startDate, 0, 4));
+        if ($days > $balance) {
+            return new JsonResponse(['error' => 'Недостатньо днів відпустки: залишилось '.$balance.'.'], 422);
+        }
+
+        // $leave = new Leave();
+        // $leave->setEmployee($user);
+        // $leave->setStartDate(new \DateTimeImmutable($startDate));
+        // $leave->setEndDate(new \DateTimeImmutable($endDate));
+        // $leave->setDays($days);
+        // $leave->setComment($data['comment'] ?? null);
+        // $leave->setStatus('pending');
+        // $this->em->persist($leave);
+        // $this->em->flush();
+
+        try {
+            $dto = $this->mapper->map($data);
+            $leave = $this->leaveFactory->create($dto, $user);
+            $leave->setStatus(LeaveStatusResolver::resolve($user));
+            $this->leaveService->save($leave);
+
+            // send email to manager
+            if ('pending' == $leave->getStatus()) {
+                $this->notificationManager->notify('new_request', $leave);
+            }
+        } catch (\Exception $e) {
+            return new JsonResponse(['error' => $e->getMessage()], 422);
+        }
+
+        return new JsonResponse($this->leaveToArray($leave), 201);
+    }
+
+    /**
+     * Cancel my leave request.
+     */
+    #[Route('/leave-requests/{id}/cancel', methods: ['POST'], requirements: ['id' => '\d+'])]
+    public function cancel(int $id): JsonResponse
+    {
+        /** @var Employee $user */
+        $user = $this->getUser();
+
+        $leave = $this->leaveService->getLeave($id);
+        // check that leave exists and belongs to user
+        if (!$leave || $leave->getEmployee()->getId() != $user->getId()) {
+            return new JsonResponse(['error' => 'Заяву не знайдено.'], 404);
+        }
+
+        $today = $this->clock->now()->format('Y-m-d');
+        if (('pending' != $leave->getStatus() && 'approved' != $leave->getStatus()) || $leave->getStartDate()->format('Y-m-d') <= $today) {
+            return new JsonResponse(['error' => 'Скасувати можна лише заяву, що ще не почалася.'], 422);
+        }
+
+        // set status to cancelled
+        $leave->setStatus('cancelled');
+        $this->em->flush();
+
+        return new JsonResponse($this->leaveToArray($leave));
+    }
+
+    /**
+     * Pending requests of manager's team.
+     */
+    #[Route('/team/leave-requests', methods: ['GET'])]
+    public function teamRequests(): JsonResponse
+    {
+        /** @var Employee $user */
+        $user = $this->getUser();
+
+        // only manager can see team requests
+        if (!$user->isManager()) {
+            return new JsonResponse(['error' => 'Доступно лише керівнику команди.'], 403);
+        }
+
+        $result = [];
+        foreach ($this->leaveService->getTeamRequests($user->getTeam()) as $holidayRequest) {
+            $result[] = [
+                'id' => $holidayRequest->getId(),
+                'employee' => [
+                    'id' => $holidayRequest->getEmployee()->getId(),
+                    'name' => $holidayRequest->getEmployee()->getName(),
+                ],
+                'startDate' => $holidayRequest->getStartDate()->format('Y-m-d'),
+                'endDate' => $holidayRequest->getEndDate()->format('Y-m-d'),
+                'workingDays' => $holidayRequest->getDays(),
+                'comment' => $holidayRequest->getComment(),
+            ];
+        }
+
+        return $this->json($result);
+    }
+
+    #[Route('/team/leave-requests/{id}/approve', methods: ['POST'], requirements: ['id' => '\d+'])]
+    public function approve(int $id): JsonResponse
+    {
+        /** @var Employee $user */
+        $user = $this->getUser();
+
+        // only manager can approve
+        if (!$user->isManager()) {
+            return new JsonResponse(['error' => 'Доступно лише керівнику команди.'], 403);
+        }
+
+        $leave = $this->leaveRepository->find($id);
+        if (!$leave) {
+            return new JsonResponse(['error' => 'Заяву не знайдено.'], 404);
+        }
+
+        // request must be from manager's team
+        if ($leave->getEmployee()->getTeam()->getId() != $user->getTeam()->getId()) {
+            return new JsonResponse(['error' => 'Доступно лише керівнику команди.'], 403);
+        }
+
+        if ('pending' != $leave->getStatus()) {
+            return new JsonResponse(['error' => 'Заяву вже розглянуто.'], 422);
+        }
+
+        $leave->setStatus('approved');
+        $this->em->flush();
+
+        // notify employee
+        $this->notificationManager->notify('approved', $leave);
+
+        return new JsonResponse([
+            'id' => $leave->getId(),
+            'status' => $leave->getStatus(),
+            'rejectionReason' => $leave->getRejectionReason(),
+        ]);
+    }
+
+    #[Route('/team/leave-requests/{id}/reject', methods: ['POST'], requirements: ['id' => '\d+'])]
+    public function reject(int $id, Request $request): JsonResponse
+    {
+        /** @var Employee $user */
+        $user = $this->getUser();
+
+        // only manager can reject
+        if (!$user->isManager()) {
+            return new JsonResponse(['error' => 'Доступно лише керівнику команди.'], 403);
+        }
+
+        $vacation = $this->leaveRepository->find($id);
+        if (!$vacation) {
+            return new JsonResponse(['error' => 'Заяву не знайдено.'], 404);
+        }
+
+        // request must be from manager's team
+        if ($vacation->getEmployee()->getTeam()->getId() != $user->getTeam()->getId()) {
+            return new JsonResponse(['error' => 'Доступно лише керівнику команди.'], 403);
+        }
+
+        if ('pending' != $vacation->getStatus()) {
+            return new JsonResponse(['error' => 'Заяву вже розглянуто.'], 422);
+        }
+
+        $data = json_decode($request->getContent(), true);
+        $reason = isset($data['reason']) ? trim($data['reason']) : '';
+        if ('' == $reason) {
+            return new JsonResponse(['error' => 'Вкажіть причину відмови.'], 422);
+        }
+
+        $vacation->setStatus('rejected');
+        $vacation->setRejectionReason($reason);
+        $this->em->flush();
+
+        // notify employee
+        $this->notificationManager->notify('rejected', $vacation, ['reason' => $reason]);
+
+        return new JsonResponse([
+            'id' => $vacation->getId(),
+            'status' => $vacation->getStatus(),
+            'rejectionReason' => $vacation->getRejectionReason(),
+        ]);
+    }
+
+    private function leaveToArray(Leave $leave): array
+    {
+        $today = $this->clock->now()->format('Y-m-d');
+
+        // leave can be cancelled only before it starts
+        $cancellable = false;
+        if (('pending' == $leave->getStatus() || 'approved' == $leave->getStatus()) && $leave->getStartDate()->format('Y-m-d') > $today) {
+            $cancellable = true;
+        }
+
+        return [
+            'id' => $leave->getId(),
+            'startDate' => $leave->getStartDate()->format('Y-m-d'),
+            'endDate' => $leave->getEndDate()->format('Y-m-d'),
+            'workingDays' => $leave->getDays(),
+            'status' => $leave->getStatus(),
+            'comment' => $leave->getComment(),
+            'rejectionReason' => $leave->getRejectionReason(),
+            'cancellable' => $cancellable,
+        ];
+    }
+
+    /**
+     * Count working days in period (without weekends and holidays).
+     */
+    private function countDays(\DateTimeImmutable $start, \DateTimeImmutable $end): int
+    {
+        $holidays = $this->holidayRepository->findBetween($start, $end);
+
+        $days = 0;
+        $period = new \DatePeriod($start, new \DateInterval('P1D'), $end->modify('+1 day'));
+        foreach ($period as $day) {
+            // skip weekends
+            if ($day->format('N') >= 6) {
+                continue;
+            }
+
+            $isHoliday = false;
+            foreach ($holidays as $holiday) {
+                if ($holiday->getDate()->format('Y-m-d') == $day->format('Y-m-d')) {
+                    $isHoliday = true;
+                    break;
+                }
+            }
+
+            if (!$isHoliday) {
+                ++$days;
+            }
+        }
+
+        return $days;
+    }
+
+    /**
+     * Remaining days of employee in year.
+     */
+    private function fetchBalance(Employee $employee, int $year): int
+    {
+        $sql = "SELECT SUM(days) FROM leave WHERE employee_id = :employee AND status IN ('pending', 'approved') AND strftime('%Y', start_date) = :year";
+        $used = $this->em->getConnection()->fetchOne($sql, [
+            'employee' => $employee->getId(),
+            'year' => (string) $year,
+        ]);
+
+        return $employee->getAnnualLeaveDays() - (int) $used;
+    }
+
+    private function calcDays(string $from, string $to): int
+    {
+        $diff = (new \DateTimeImmutable($from))->diff(new \DateTimeImmutable($to));
+
+        return $diff->days + 1;
+    }
+}
