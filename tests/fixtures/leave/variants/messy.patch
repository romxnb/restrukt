+<?php
+
+namespace App\Mapper;
+
+use App\Dto\LeaveRequestDTO;
+
+class LeaveRequestMapper
+{
+    /**
+     * Maps request data to DTO.
+     */
+    public function map(array $data): LeaveRequestDTO
+    {
+        $holidayRequest = new LeaveRequestDTO();
+        $holidayRequest->startDate = $data['startDate'] ?? null;
+        $holidayRequest->endDate = $data['endDate'] ?? null;
+
+        // empty comment is saved as null
+        if (isset($data['comment']) && '' !== trim($data['comment'])) {
+            $holidayRequest->comment = $data['comment'];
+        } else {
+            $holidayRequest->comment = null;
+        }
+
+        if (null === $holidayRequest->startDate || null === $holidayRequest->endDate) {
+            throw new \InvalidArgumentException('Вкажіть дати у форматі РРРР-ММ-ДД.');
+        }
+
+        return $holidayRequest;
+    }
+}
