+<?php
+
+namespace App\Repository;
+
+use App\Entity\Employee;
+use App\Entity\Leave;
+use App\Entity\Team;
+use Doctrine\Bundle\DoctrineBundle\Repository\ServiceEntityRepository;
+use Doctrine\Persistence\ManagerRegistry;
+
+/**
+ * @extends ServiceEntityRepository<Leave>
+ */
+class LeaveRepository extends ServiceEntityRepository
+{
+    public function __construct(ManagerRegistry $registry)
+    {
+        parent::__construct($registry, Leave::class);
+    }
+
+    public function save(Leave $entity, bool $flush = false): void
+    {
+        $this->getEntityManager()->persist($entity);
+
+        if ($flush) {
+            $this->getEntityManager()->flush();
+        }
+    }
+
+    /**
+     * Leaves of employee in year.
+     *
+     * @return Leave[]
+     */
+    public function loadLeaves(Employee $employee, int $year): array
+    {
+        return $this->createQueryBuilder('l')
+            ->where('l.employee = :employee')
+            ->andWhere('l.startDate >= :from')
+            ->andWhere('l.startDate <= :to')
+            ->setParameter('employee', $employee)
+            ->setParameter('from', $year.'-01-01')
+            ->setParameter('to', $year.'-12-31')
+            ->orderBy('l.startDate', 'ASC')
+            ->addOrderBy('l.id', 'ASC')
+            ->getQuery()
+            ->getResult();
+    }
+
+    /**
+     * @return Leave[]
+     */
+    public function findPendingHolidayRequestsByTeam(Team $team): array
+    {
+        return $this->createQueryBuilder('v')
+            ->join('v.employee', 'e')
+            ->where('e.team = :team')
+            ->andWhere("v.status = 'pending'")
+            ->setParameter('team', $team)
+            ->orderBy('v.startDate', 'ASC')
+            ->addOrderBy('v.id', 'ASC')
+            ->getQuery()
+            ->getResult();
+    }
+}
